# Copia este archivo con el nombre .env y pon tus datos.

# --- Base de datos LOCAL (PostgreSQL instalado en tu computador) ---
DB_HOST=localhost
DB_NAME=inwork
DB_USER=postgres
DB_PASSWORD=tu_clave_de_postgres
DB_PORT=5432

# --- Base de datos en la NUBE (Neon) ---
# Para usar la nube, pon # delante de las 5 lineas de arriba y quitaselo a estas:
# DB_HOST=tu-host.neon.tech
# DB_NAME=neondb
# DB_USER=tu_usuario
# DB_PASSWORD=tu_clave
# DB_PORT=5432

# La API de pagos (Express) debe tener EXACTAMENTE esta misma SECRET_KEY en su .env
SECRET_KEY=cambia_esta_clave_por_una_larga
ACCESS_TOKEN_EXPIRE_MINUTES=60
PAGOS_API_URL=http://localhost:3000
